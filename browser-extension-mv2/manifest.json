{
  "manifest_version": 2,
  "name": "Deepbridge Finder Bridge (MV2)",
  "version": "0.1.0",
  "description": "Persistent browser bridge for Deepbrid Finder.",
  "permissions": ["tabs", "storage", "https://www.deepbrid.com/*", "https://57mwpz.deepascension.net/*"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "web_accessible_resources": ["page-fetch.js"],
  "browser_action": { "default_title": "Deepbridge Finder Bridge", "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://57mwpz.deepascension.net/*/finder-auth"], "js": ["pair.js"] },
    { "matches": ["https://www.deepbrid.com/*"], "js": ["deepbrid.js"] }
  ]
}
