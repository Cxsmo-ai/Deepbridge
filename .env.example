PORT=7000
BASE_URL=http://localhost:7000
DEEPBRID_API_KEY=your_deepbrid_api_key_here

# Optional Deepbrid website Usenet Finder source. API key alone does not
# unlock /usenet-finder search; this needs a logged-in Deepbrid web session
# cookie. Prefer server-level env over embedding the cookie in a Stremio token.
DEEPBRID_WEB_COOKIE=
DEEPBRID_WEB_USER_AGENT=
# Optional Cloudflare solver for hosted deployments. On the Oracle proxynet
# stack this is usually http://byparr:8191/v1. This does not replace the
# Deepbrid login cookie; it only obtains VM-local Cloudflare clearance.
DEEPBRID_BYPARR_URL=
DEEPBRID_USENET_FINDER_ENABLED=true
DEEPBRID_USENET_FINDER_MAX_RESULTS=4
DEEPBRID_USENET_FINDER_MAX_PROCESS=5

# Optional built-in Newshosting source. You can also configure this per
# generated addon link in the web UI instead of setting global env values.
NEWSHOSTING_USERNAME=
NEWSHOSTING_PASSWORD=
NEWSHOSTING_SERVER_HOST=srv.aboutusenet.com
NEWSHOSTING_SERVER_IP=81.171.93.8
NEWSHOSTING_SERVER_PORT=5598
NEWSHOSTING_MAX_NZB_FILES=32

# Optional: set NODE_ENV=production in Docker or hosted deployments.
NODE_ENV=development
