{
    "name":  "deepbridge-stremio-addon",
    "version":  "1.0.0",
    "description":  "A self-hosted Stremio addon that combines Deepbrid official streams with pre-resolved external Usenet indexer results.",
    "main":  "dist/server.js",
    "type":  "commonjs",
    "license":  "Apache-2.0",
    "author":  "Deepbridge contributors",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/Cxsmo-ai/Deepbridge.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/Cxsmo-ai/Deepbridge/issues"
             },
    "homepage":  "https://github.com/Cxsmo-ai/Deepbridge#readme",
    "engines":  {
                    "node":  "\u003e=22.0.0",
                    "npm":  "\u003e=10.0.0"
                },
    "scripts":  {
                    "start":  "node dist/server.js",
                    "start:prod":  "node dist/server.js",
                    "dev":  "nodemon --watch src -e ts --exec ts-node src/server.ts",
                    "build":  "tsc",
                    "check":  "npm run build",
                    "test":  "npm run build && node scripts/test-newshosting-protocol.mjs",
                    "docker:build":  "docker build -t deepbridge:local ."
                },
    "keywords":  [
                     "stremio",
                     "stremio-addon",
                     "deepbrid",
                     "usenet",
                     "newznab",
                     "indexer",
                     "fastify",
                     "typescript",
                     "docker"
                 ],
    "dependencies":  {
                         "@fastify/cors":  "^11.2.0",
                         "@fastify/formbody":  "^8.0.2",
                         "@fastify/static":  "^9.1.3",
                         "dotenv":  "^17.4.2",
                         "fastify":  "^5.8.5",
                         "lru-cache":  "^11.5.1",
                         "nanoid":  "^5.1.11",
                         "pino":  "^10.3.1",
                         "pino-pretty":  "^13.1.3",
                         "undici":  "^8.4.0",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/node":  "^25.9.2",
                            "nodemon":  "^3.1.14",
                            "ts-node":  "^10.9.2",
                            "typescript":  "^6.0.3"
                        }
}
